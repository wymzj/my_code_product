1.栈示例代码：

#define N 100

void push(int s[], int& top, int x)
{
    if (top == N)
        printf("overflow");
    else
    {
        s[top] = x;
        top++;
    }
}

void pop(int s[], int& top, int& y)
{
    if (top == 0)
        printf("underflow");
    else
    {
        y = s[top-1];
        top--;
    }
}

int main() {

    int s[N] = { 0 };
    int top = 0;

    push(s, top, 22);
    push(s, top, 33);

    int out_stack;
    pop(s,top, out_stack);
    cout<<out_stack<<endl;

    pop(s, top, out_stack);
    cout << out_stack << endl;
    return 0;
}

2.队列示列代码：
#include <iostream>

using namespace std;

struct Node
{
	Node* privious;
	Node* next;
	int content;
};

Node* pHead = NULL;  //链表头部的结点
Node* pTail = NULL;  //链表尾部的结点 
void push(Node& node)
{
     if(pTail==NULL && pHead==NULL)
     {
	 	 pHead = &node;
	 	 pTail = &node;
	 	 node.privious = NULL;
	 	 node.next = NULL;
     }
	 else
	 {
	 	 node.next = NULL;
	 	 node.privious = pTail;
	 	 pTail->next = &node;
	 	 pTail = &node;
	 }	
     	
}

Node* pop()
{
    if (pTail==NULL && pHead==NULL) 
		return NULL;
    else
    {
    	Node* ptemp = pHead;
    	if(pHead->next)    //如果是最后一个就没有下一个Node指针
			pHead->next->privious=NULL;
        pHead = pHead->next;
        return ptemp;
    }
}

int main() {
    
    Node a1, a2, a3;
    a1.content = 1;
    a2.content = 2;
    a3.content = 3;
    push(a1);
    push(a2);
    push(a3);
    Node* b1 = pop();
    cout<<b1->content<<endl;
    Node* b2 = pop();
	cout<<b2->content<<endl;
	Node* b3 = pop();
	cout<<b3->content<<endl;
    return 0;
}
