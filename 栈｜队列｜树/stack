#define N 100

void push(int s[], int& top, int x)
{
    if (top == N)
        printf("overflow");
    else
    {
        s[top] = x;
        top++;
    }
}

void pop(int s[], int& top, int& y)
{
    if (top == 0)
        printf("underflow");
    else
    {
        y = s[top-1];
        top--;
    }
}

int main() {

    int s[N] = { 0 };
    int top = 0;

    push(s, top, 22);
    push(s, top, 33);

    int out_stack;
    pop(s,top, out_stack);
    cout<<out_stack<<endl;

    pop(s, top, out_stack);
    cout << out_stack << endl;
    return 0;
}

