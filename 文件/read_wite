//重定向版
#include <cstdio>

int main()
{
    freopen("csp.in","r",stdin);     //以标准流读入的方式打开文件
    freopen("csp.out","w",stdout);   //以标准流写入的方式打开文件
    fclose(stdin);
    fclose(stdout);
    return 0;
}

