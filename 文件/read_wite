#include <iostream>
using namespace std;

const int N=10;
int main() {
	freopen("csp.out","w",stdout);   //以标准流写入的方式打开文件
	int temp = 0;
	for(int i=0;i<N;i++)
	{
	    temp++;
	    cout<<temp<<" ";             //printf同样
	}
	int a[N]={0};
	
	freopen("csp.out","r",stdin);     //以标准流读入的方式打开文件
	for(int i=0;i<N;i++)
	    cin>>a[i];                    //scanf同样
		
	fclose(stdin);
	fclose(stdout);
	freopen("CON","w",stdout);       //CON表示控制台，表示重新定向到控制台。      
	for(int i=0;i<N;i++)
	    cout<<a[i]<<" ";
	fclose(stdout);
	return 0;
}
//fopen
int main()
{
	FILE *fin,*fout;

	fout=fopen("csp.txt","wb");
	int temp,sum=0;
	for(int i=1; i<=N; i++)
	    fprintf(fout,"%d ",i);         //写入文件
	    
	fclose(fout);
	fin=fopen("csp.txt","rb");
	while(fscanf(fin,"%d",&temp)==1)   //从输入文件中读入数据
	{
	    cout<<temp<<endl;
	    sum += temp;
	}
	cout<<sum<<endl;
	fclose(fin);
	return 0;
}

文件输入输出流
设备都是磁盘文件。C+十可以在创建对象时,设定输人或输出到哪个文件。由于这些定义是在fstream中进行的,因此,在使用这此类进行输入输出操作时,必须要在程序的利用#include指令包进fstream头文件。
例如:若想用fin作为输入对象,fout作为输出对象,则可以使用如下定义:
ifstream fin("输人文件名.扩展名");
ofstream fout("输出文件名.扩展名");
如果想再次使用cin和cout,是否要逐个把程序中的所有fin和fout替换为cin用这么麻烦,只需要把fin和fout的声明语句去掉,并加上这样两行即可:
#define fin cin
#define fout cout
用条件编译,还可以让程序在本机上读写标准输入输出,比赛测试时读写文件。
程序如下:

#include <fstream>
#include <iostream>

using namespace std;
int main()
{
    //使用文件输入输出流,对cin、cout语法
    ifstream fin("in.txt");//定义输入文件名
    ofstream fout("out.txt");//定义输出文件名
    int temp,sum=0;
    while(fin>>temp)
        sum=sum+temp;//从输入文件中读入数据
    fout<<sum<<endl;
    fin.close();
    fout.close();//关闭文件,可省略
    cout<<"original IO"<<endl;
    return 0;
}
