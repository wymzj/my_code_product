#include<iostream>
using namespace std;
const int MAXN=10001;
int main()
{
    int n,i,j,k;
    float temp,a[MAXN];
    cin>>n;
    for (i=0;i<n;i++)
          cin>>a[i];                         //输入n个数 
    for(i=1; i<=n; i++)
    { 
       for(j=i-1; j>=0; j--)                 //在前面有序区间中为a[i]找合适的插入位置 
           if(a[j]<=a[i]) break;            //找到比a[i]小的位置就退出,插入其后 
       if (j!=i-1)
       {
           temp=a[i];                      //将比a[i]大的数据向后移 
           for(k=i-1;k>j;k--)
               a[k+1]=a[k];                //将a[i]放在正确位置上 
           a[k+1]=temp;
       }
    }
    for (int i=1;i<n;i++)
         cout<<a[i]<<" ";                    //输出排序的结果 
    return 0; 
}
